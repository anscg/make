# Internal Rails origin. Not publicly reachable in production.
RAILS_URL=http://localhost:3000

# Public host the browser sees. Rails builds redirect URLs from this.
PUBLIC_HOST=localhost:3001

# Shared secret proving a request came through this proxy. Leave unset in dev;
# Rails' origin check no-ops when it is blank on both sides.
# ORIGIN_SECRET=

# Detecting an existing Hack Club Auth session to offer "Join as …".
# Off by default: the whoami endpoint serves no CORS headers today, so the
# browser cannot call it. Flip to true once it does. See lib/hca.ts.
# NEXT_PUBLIC_HCA_DETECT_SESSION=true
# Staging HCA is what Rails signs against outside production.
# NEXT_PUBLIC_HCA_URL=https://hca.dinosaurbbq.org
