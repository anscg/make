<% content_for :title, "Projects" %>

<h1>Projects</h1>

<%= form_with url: staff_projects_path, method: :get do |f| %>
  <%= f.search_field :query, value: params[:query], placeholder: "Search by name" %>
  <%= f.submit "Search" %>
<% end %>

<% if @projects.empty? %>
  <p>No projects match.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Project</th><th>Kid</th><th>Ships</th><th>Created</th><th></th></tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr class="<%= "discarded" if project.discarded? %>">
          <td><%= project.name %><%= " (unlisted)" if project.is_unlisted %></td>
          <td><%= project.user.name %></td>
          <td><%= project.ships.size %></td>
          <td><%= project.created_at.strftime("%b %-d, %Y") %></td>
          <td><%= link_to "View", staff_project_path(project.public_id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
