# Copy the per-app blocks into api/.env.development and web/.env.local.
# Nothing reads this file directly; it documents the full set.

# ---- api/.env.development (Rails) ----
HASHID_SALT=
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
# Encrypt User#hca_access_token and Ship#frozen_hca_data at rest. Optional in
# development and test (derived from secret_key_base); required in production.
# Generate a set with `bin/rails db:encryption:init`.
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=
# Shared secret proving a request arrived via the Next proxy. Unset in dev.
# ORIGIN_SECRET=

# ---- web/.env.local (Next) ----
RAILS_URL=http://localhost:3000
PUBLIC_HOST=localhost:3001
# ORIGIN_SECRET=

# ---- production only (Rails) ----
# PUBLIC_HOST=make.hackclub.com
# STAFF_HOST=staff.make.hackclub.com
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=
# DATABASE_URL=
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=
